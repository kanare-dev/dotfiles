{
  "model": "opusplan",
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@2.2.23",
    "padding": 0
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/markdownlint.sh\""
          }
        ]
      }
    ]
  },
  "tui": "fullscreen",
  "agentPushNotifEnabled": true
}
